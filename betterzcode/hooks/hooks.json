{
  "description": "Evidence-gated pipeline: injects the doctrine at session start, logs executed proof and fetched sources, and locks the conclusion until proof exists.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/gate_hook.mjs",
              "session_start"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/gate_hook.mjs",
              "evidence"
            ],
            "timeoutMs": 5000
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|webReader|webSearchPrime|web_reader|web_search_prime",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/gate_hook.mjs",
              "sources"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/gate_hook.mjs",
              "stop"
            ],
            "timeoutMs": 8000
          }
        ]
      }
    ]
  }
}
